{
  "name": "@hrshx3o5o6/tomnjerry",
  "version": "3.0.0",
  "description": "Stops your AI coding agent from overbuilding. Lifecycle hooks for Claude Code, Codex, Hermes, opencode, Pi, Gemini CLI and Antigravity that find existing code, skip unnecessary packages, prove changes work, and learn your codebase.",
  "type": "commonjs",
  "main": "adapters/opencode.mjs",
  "bin": {
    "tomnjerry": "bin/tomnjerry.js"
  },
  "files": [
    "bin",
    "core",
    "adapters",
    "cli",
    "tnj",
    "templates",
    "docs/compatibility.md",
    "docs/design-principles.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    ".claude-plugin",
    ".codex-plugin",
    "integrations"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "doctor": "node bin/tomnjerry.js doctor",
    "test": "node --test test/",
    "bench": "bash benchmarks/agentic/run.sh",
    "bench-ci": "bash benchmarks/agentic/run-ci.sh",
    "prepack": "node -e \"require('fs').existsSync('LICENSE') || process.exit(1)\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrshx3o5o6/Tom-n-Jerry.git"
  },
  "keywords": [
    "agents",
    "loop-engine",
    "opportunism",
    "prompt-engineering",
    "cursor",
    "claude",
    "npx",
    "agent-skills",
    "opportunity-detection",
    "opencode",
    "self-improving",
    "claude-code",
    "codex",
    "hermes",
    "hooks",
    "gemini-cli",
    "antigravity",
    "pi-package",
    "opencode-plugin",
    "claude-code-plugin"
  ],
  "author": "harsha <hrshx3o5o6@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hrshx3o5o6/Tom-n-Jerry/issues"
  },
  "homepage": "https://github.com/hrshx3o5o6/Tom-n-Jerry#readme",
  "devDependencies": {
    "promptfoo": "^0.121.19"
  },
  "pi": {
    "extensions": [
      "./adapters/pi.mjs"
    ],
    "skills": [
      "./tnj/skills"
    ]
  }
}
